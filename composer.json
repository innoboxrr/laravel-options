{
    "name": "innoboxrr/laravel-options",
    "description": "App Options",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LaravelOptions\\": "src/",
            "Innoboxrr\\LaravelOptions\\Database\\Seeders\\": "database/seeders/",
            "Innoboxrr\\LaravelOptions\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LaravelOptions\\Providers\\AppServiceProvider",
                "Innoboxrr\\LaravelOptions\\Providers\\AuthServiceProvider",
                "Innoboxrr\\LaravelOptions\\Providers\\EventServiceProvider",
                "Innoboxrr\\LaravelOptions\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LaravelOptions\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Necesario para la exportacion de opciones (OptionsExports implementa FromView) (^3.1)."
    }
}
